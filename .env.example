# Copy to .env and adjust values for local Docker Compose runs.
SERVER_PORT=8080
POSTGRES_PORT=5432
POSTGRES_USER=library
POSTGRES_PASSWORD=library
POSTGRES_DB=library_management

# Must be at least 32 characters. Prefer a random value in real environments.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=library-management

SEED_ADMIN_EMAIL=admin@library.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULL_NAME=Library Admin
